/* Modern product-style desktop UI. Opaque surfaces preserve contrast on every platform.
   System-installed fonts only. Status always includes text, not just color. */
QWidget { background: #f6f7fb; color: #202637; font-family: "Segoe UI", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif; font-size: 14px; selection-background-color: #dcecff; selection-color: #202637; }
QLabel[uiClass="membershipStatus"] { background: #253153; color: #ffffff; border-radius: 18px; padding: 16px 20px; font-size: 16px; font-weight: 600; }
QFrame[uiClass="memberPlan"] { background: #ffffff; border: 1px solid #e4e8f4; border-radius: 18px; }
QFrame[uiClass="memberPlan"][level="SVIP"] { background: #eef0ff; border-color: #cfd6f5; }
QLabel, QRadioButton, QCheckBox { background: transparent; }
QLabel[uiClass="pageTitle"], QLabel#appTitle { font-size: 28px; font-weight: 700; padding: 2px 0; }
QLabel[uiClass="dialogTitle"] { font-size: 30px; font-weight: 700; }
QLabel[uiClass="heroTitle"] { font-size: 42px; font-weight: 700; }
QLabel[uiClass="welcomeTitle"] { font-size: 28px; font-weight: 700; }
QLabel[uiClass="heroCaption"] { color: #64646c; font-size: 14px; }
QLabel[uiClass="sectionTitle"], QLabel[uiClass="cardTitle"] { font-size: 17px; font-weight: 600; }
QLabel[uiClass="profileName"] { font-size: 28px; font-weight: 700; }
QLabel[uiClass="balanceValue"], QLabel[uiClass="statValue"] { font-size: 30px; font-weight: 700; color: #202637; }
QLabel[uiClass="muted"], QLabel[tone="muted"] { color: #687286; font-size: 12px; }
QLabel[uiClass="eyebrow"] { color: #687286; font-size: 11px; font-weight: 600; }
QLabel[uiClass="formLabel"] { font-size: 13px; font-weight: 600; color: #515159; }
QLabel[tone="error"], QLabel[uiClass="errorText"] { color: #b42332; font-size: 13px; }
QLabel[tone="success"] { color: #237746; font-size: 13px; }
QLabel[uiClass="successBanner"] { background: #e6f5ec; border: 1px solid #cde6d7; border-radius: 10px; color: #237746; padding: 9px 14px; }
QFrame[uiClass="card"], QWidget#userLoginCard, QWidget#adminLoginCard { background: #ffffff; border: 1px solid #e9ecf4; border-radius: 24px; }
QFrame[uiClass="statCard"] { background: #ffffff; border: 1px solid #e9ecf4; border-radius: 20px; }
QFrame#statAccent { background: #6475df; border: none; border-radius: 2px; }
QFrame#statAccent[tone="green"] { background: #34a96c; }
QFrame#statAccent[tone="amber"] { background: #eaa43a; }
QFrame#statAccent[tone="violet"] { background: #af74db; }
QWidget#faultBanner { background: #fff4df; border: 1px solid #f1dbad; border-radius: 10px; }
QWidget#faultBanner QLabel { color: #88530b; }
QFrame#terminalHeader { background: transparent; border: none; }
QLabel[uiClass="brandName"] { font-size: 20px; font-weight: 700; }
QFrame#terminalSidebar { background: #ededf0; border: none; border-right: 1px solid #dddde3; }
QFrame#terminalSidebar QLabel { background: transparent; }
QLabel#terminalSidebarFooter { color: #767680; font-size: 11px; padding: 16px 8px; }
QPushButton { min-height: 20px; padding: 9px 16px; border: 1px solid #dedee4; border-radius: 12px; background: #ffffff; color: #35353c; font-weight: 500; }
QPushButton:hover { background: #f0f0f4; border-color: #c3c3cc; }
QPushButton:pressed { background: #e3e3e9; border-color: #aaaab4; }
QPushButton:focus { border-color: #6475df; }
QPushButton:disabled { background: #eeeef2; border-color: #e2e2e8; color: #8a8a94; }
QPushButton[uiClass="primary"] { background: #5264d6; border-color: #5264d6; color: #ffffff; font-weight: 600; }
QPushButton[uiClass="primary"]:hover { background: #6477e7; border-color: #6477e7; }
QPushButton[uiClass="primary"]:pressed { background: #3c4cab; border-color: #3c4cab; }
QPushButton[uiClass="primary"]:focus { border: 2px solid #003c80; padding: 8px 15px; }
QPushButton[uiClass="primary"]:disabled, QPushButton[uiClass="compactPrimary"]:disabled { background: #d8e7f8; border-color: #d8e7f8; color: #738ba8; }
QPushButton[uiClass="compactPrimary"] { min-height: 16px; padding: 1px 6px; border-radius: 6px; background: #edf0ff; border-color: transparent; color: #4659bf; }
QPushButton[uiClass="compactPrimary"]:hover { background: #cfe5ff; }
QPushButton[uiClass="compactPrimary"]:pressed { background: #bad8fd; }
QPushButton[uiClass="secondary"] { background: #edf0ff; border-color: transparent; color: #4659bf; }
QPushButton[uiClass="secondary"]:hover { background: #e4e8ff; }
QPushButton[uiClass="secondary"]:pressed { background: #d7dfff; }
QPushButton[uiClass="danger"] { background: #fff5f5; border-color: #f1d4d5; color: #b42332; }
QPushButton[uiClass="danger"]:hover { background: #fbe5e7; }
QPushButton[uiClass="danger"]:pressed { background: #f4cdd1; }
QPushButton[uiClass="text"] { min-height: 16px; padding: 4px 8px; background: transparent; border: 1px solid transparent; color: #5061c5; }
QPushButton[uiClass="text"]:hover { background: #e5effb; }
QPushButton[uiClass="text"]:pressed { background: #d2e4f9; }
QPushButton[uiClass="text"]:focus, QPushButton[uiClass="secondary"]:focus, QPushButton[uiClass="compactPrimary"]:focus { border-color: #6475df; }
QPushButton[uiClass="stationCard"] { padding: 0; text-align: left; background: #ffffff; border: 1px solid #e9ecf4; border-radius: 20px; }
QPushButton[uiClass="stationCard"]:hover { background: #fafcff; border-color: #9cc9fb; }
QPushButton[uiClass="stationCard"]:pressed { background: #edf5ff; border-color: #6475df; }
QPushButton[uiClass="stationCard"]:focus { border: 2px solid #6475df; }
QTabWidget::pane { background: #f6f7fb; border: none; }
QTabBar::tab { min-width: 90px; padding: 10px 20px; margin: 3px; background: #e9e9ee; color: #62626b; border-radius: 8px; }
QTabBar::tab:selected { background: #ffffff; color: #202637; font-weight: 600; }
QTabBar::tab:hover:!selected { background: #dfdfe6; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QPlainTextEdit, QTextEdit { min-height: 22px; padding: 9px 11px; background: #ffffff; border: 1px solid #d9d9e1; border-radius: 12px; }
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QDateEdit:hover { border-color: #aaaab5; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QPlainTextEdit:focus, QTextEdit:focus { border: 2px solid #6475df; padding: 8px 10px; }
QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled { background: #eeeef2; color: #8a8a94; }
QDateEdit[calendarButtonVisible="true"] { padding-right: 35px; }
QDateEdit[calendarButtonVisible="true"]::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 32px; border: none; }
QDateEdit[calendarButtonVisible="true"]::down-arrow { image: url(:/icons/edit.xpm); width: 16px; height: 16px; }
QDateEdit[calendarButtonVisible="false"]::drop-down { width: 0; border: none; }
QDateEdit[calendarButtonVisible="false"]::down-arrow { image: none; }
QComboBox::drop-down { width: 28px; border: none; }
QComboBox QAbstractItemView { background: #ffffff; border: 1px solid #d1d1da; padding: 4px; selection-background-color: #6475df; selection-color: #ffffff; }
QComboBox QAbstractItemView::item:hover { background: #edf0ff; color: #202637; }
QListWidget#sidebarNavigation, QListWidget#userNavigation { background: transparent; color: #515159; border: none; outline: none; padding: 0; }
QListWidget#sidebarNavigation::item, QListWidget#userNavigation::item { height: 42px; padding: 0 10px; margin: 3px 0; border: 1px solid transparent; border-radius: 8px; }
QListWidget#sidebarNavigation::item:hover, QListWidget#userNavigation::item:hover { background: #e0e0e7; }
QListWidget#sidebarNavigation::item:selected, QListWidget#userNavigation::item:selected { background: #5264d6; color: #ffffff; font-weight: 600; }
QListWidget#sidebarNavigation::item:focus, QListWidget#userNavigation::item:focus { border-color: #00458f; }
QTableWidget, QTableView { background: #ffffff; alternate-background-color: #f8f8fa; border: 1px solid #e1e1e8; border-radius: 10px; gridline-color: #ededf2; selection-background-color: #dcecff; selection-color: #202637; outline: none; }
QTableWidget::item:hover, QTableView::item:hover { background: #edf5ff; }
QHeaderView::section { background: #eeeef2; color: #687286; border: none; border-bottom: 1px solid #dddde5; padding: 10px 7px; font-size: 12px; font-weight: 600; }
QHeaderView::section:hover { background: #e4e4eb; }
QStatusBar { background: #f6f7fb; color: #687286; border-top: 1px solid #e9ecf4; font-size: 11px; }
QStatusBar::item { border: none; }
QMessageBox QPushButton, QDialogButtonBox QPushButton { min-width: 76px; }
QToolTip { background: #ffffff; color: #202637; border: 1px solid #d1d1da; padding: 6px 9px; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { width: 10px; margin: 2px; background: transparent; }
QScrollBar:horizontal { height: 10px; margin: 2px; background: transparent; }
QScrollBar::handle:vertical { min-height: 30px; background: #c3c3cc; border-radius: 3px; }
QScrollBar::handle:horizontal { min-width: 30px; background: #c3c3cc; border-radius: 3px; }
QScrollBar::handle:hover { background: #91919d; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QRadioButton, QCheckBox { spacing: 7px; padding: 4px; }
QRadioButton::indicator, QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #b0b0bb; background: #ffffff; border-radius: 4px; }
QRadioButton::indicator { border-radius: 8px; }
QRadioButton::indicator:checked, QCheckBox::indicator:checked { background: #6475df; border: 2px solid #b9d9ff; }
QRadioButton:focus, QCheckBox:focus { color: #5061c5; }
QLabel#profileAvatar { background: #e7effb; border: 1px solid #d6e3f5; border-radius: 20px; color: #5061c5; }
QLabel[uiClass="orderStatus"] { border-radius: 8px; padding: 5px 12px; font-weight: 600; background: #eeeef2; color: #62626c; }
QLabel[orderStatus="reserved"] { background: #fff3dc; color: #88530b; }
QLabel[orderStatus="charging"] { background: #e4f0ff; color: #4659bf; }
QLabel[orderStatus="pending_settlement"] { background: #ffebe2; color: #a54e1c; }
QLabel[orderStatus="settled"] { background: #e4f5eb; color: #237746; }
QLabel[orderStatus="cancelled"] { background: #eeeef2; color: #62626c; }
QLabel[uiClass="orderSettlementHint"] { color: #a54e1c; font-weight: 600; }
QLabel[uiClass="loadingOverlay"] { background: rgba(250,250,252,240); color: #5061c5; font-size: 16px; }
QLabel[uiClass="stationMeta"], QLabel[uiClass="navigationPreview"] { background: #edf4ff; border: 1px solid #d6e5f9; border-radius: 12px; padding: 14px; color: #3b5a80; }
QLabel[uiClass="stationSymbol"] { background: #f0f4fb; border-radius: 12px; }
QLabel[uiClass="stationPrice"] { color: #237746; font-size: 12px; }
QLabel[uiClass="stationDistance"] { color: #202637; font-size: 20px; font-weight: 600; }
QLabel[uiClass="linkCaption"] { color: #5061c5; font-size: 12px; }
QLabel[uiClass="flowStep"] { background: #eaeaf0; color: #687286; border-radius: 12px; padding: 12px 8px; font-size: 12px; }
QLabel[uiClass="flowStep"][active="true"] { background: #e9edff; color: #4659bf; font-weight: 600; }
QLabel[uiClass="chargeInfo"] { color: #202637; font-size: 22px; font-weight: 600; }
QLabel[uiClass="chargePrice"] { color: #62626c; font-size: 17px; }
QLabel[uiClass="chargeGlyph"] { background: #e9f2ff; color: #5264d6; border-radius: 24px; padding: 22px; font-size: 32px; font-weight: 700; }
QLabel[uiClass="mapStatus"] { color: #4659bf; font-size: 16px; padding: 10px 14px; background: #eaf3ff; border-radius: 12px; }
QProgressBar { min-height: 24px; background: #eaeaf0; color: #202637; border: 1px solid #d8d8e1; border-radius: 8px; text-align: center; }
QProgressBar::chunk { background: #b5c3fc; border-radius: 7px; }
QPushButton[uiClass="text"]:disabled, QPushButton[uiClass="secondary"]:disabled, QPushButton[uiClass="danger"]:disabled { background: #eeeef2; border-color: #e2e2e8; color: #8a8a94; }
QPushButton[uiClass="ratingStar"] { min-height: 20px; padding: 2px; background: transparent; border: 1px solid transparent; color: #9b6300; font-size: 24px; }
QPushButton[uiClass="ratingStar"]:hover { background: #fff2d8; }
QPushButton[uiClass="ratingStar"]:pressed { background: #f6dfa6; }
QPushButton[uiClass="ratingStar"]:focus { border-color: #6475df; }
QPushButton[uiClass="stationCard"][available="false"] QLabel[uiClass="stationPrice"] { color: #687286; }
/* Discovery and navigation: a spacious product surface rather than a data-entry shell. */
QFrame#userTopBar { background: #ffffff; border: 1px solid #edf0f6; border-radius: 18px; }
QWidget#userBottomBar { background: transparent; border: none; }
QToolButton[uiClass="bottomNavigation"] { min-height: 65px; padding: 5px 18px; background: transparent; border: none; border-radius: 14px; color: #626d82; font-size: 12px; }
QToolButton[uiClass="bottomNavigation"]:hover { background: transparent; color: #626d82; font-size: 12px; font-weight: 400; }
QToolButton[uiClass="bottomNavigation"]:checked { background: transparent; color: #5264d6; font-weight: 600; }
QToolButton#xiaoqingButton { padding: 0; background: transparent; border: none; color: #4659bf; font-weight: 600; }
QToolButton#xiaoqingButton:hover { background: transparent; color: #4659bf; font-weight: 600; }
QFrame#chatHistoryPanel { background: #f3f4f8; border: none; border-radius: 16px; }
QListWidget#chatSessionList { background: transparent; border: none; outline: none; }
QListWidget#chatSessionList::item { padding: 0; border-radius: 9px; color: #3d4558; }
QListWidget#chatSessionList::item:selected { background: #ffffff; color: #202637; font-weight: 600; }
QListWidget#chatSessionList::item:hover { background: #e9ebf2; }
QListWidget#chatSessionList QWidget { background: transparent; }
QPushButton[uiClass="chatSessionOpen"] { min-height: 20px; padding: 4px 2px; background: transparent; border: none; color: #3d4558; text-align: left; }
QPushButton[uiClass="chatSessionOpen"]:hover { background: transparent; color: #202637; }
QToolButton[uiClass="chatSessionDelete"] { background: transparent; border: none; color: #8991a2; font-size: 17px; }
QToolButton[uiClass="chatSessionDelete"]:hover { background: #ffe8e8; color: #c53535; border-radius: 7px; }
QToolButton#collapseHistory { background: #f3f4f8; border: none; border-radius: 10px; color: #4659bf; font-size: 22px; }
QToolButton#openChatHistory { background: #ffffff; border: 1px solid #e2e5ed; border-radius: 10px; }
QToolButton#openChatHistory:hover { background: #f0f2f7; }
QToolButton#collapseHistory:hover { background: #f3f4f8; }
QScrollArea#chatMessagesScroll { background: #ffffff; border: 1px solid #e8eaf0; border-radius: 16px; }
QScrollArea#chatMessagesScroll > QWidget > QWidget { background: #ffffff; }
QWidget[uiClass="chatMessageRow"] { background: transparent; }
QWidget[uiClass="chatMessageGroup"] { background: transparent; }
QWidget[uiClass="chatIdentity"] { background: transparent; }
QFrame[uiClass="chatBubble"] { border: 1px solid #e6e8ee; border-radius: 16px; }
QFrame[uiClass="chatBubble"][role="user"] { background: #5264d6; border-color: #5264d6; }
QFrame[uiClass="chatBubble"][role="assistant"] { background: #f4f5f7; }
QFrame[uiClass="chatBubble"][state="failed"] { background: #fff1f1; border: 1px solid #f0caca; }
QLabel[uiClass="chatMessageText"] { color: #202637; font-size: 14px; background: transparent; }
QFrame[uiClass="chatToolCard"] { background: #e9edff; border: none; border-radius: 9px; }
QLabel[uiClass="chatToolStatus"] { color: #5264d6; font-size: 12px; background: transparent; border: none; }
QPushButton[uiClass="chatToolDetails"] { color: #5264d6; font-size: 12px; background: transparent; border: none; padding: 2px 4px; }
QPushButton[uiClass="chatToolDetails"]:hover { color: #3348c4; background: transparent; text-decoration: underline; }
QFrame[uiClass="chatBubble"][role="user"] QLabel[uiClass="chatMessageText"], QFrame[uiClass="chatBubble"][role="user"] QLabel[uiClass="chatSender"] { color: #ffffff; }
QLabel[uiClass="chatSender"] { color: #687286; font-size: 11px; font-weight: 600; background: transparent; }
QLabel[uiClass="userChatAvatar"] { background: #202637; color: #ffffff; border-radius: 19px; font-weight: 600; }
QLabel[uiClass="assistantChatAvatar"] { background: #ffffff; border: 1px solid #e2e5ed; border-radius: 19px; }
QLabel[uiClass="chatEmptyHint"] { color: #687286; font-size: 16px; background: transparent; }
QPushButton[uiClass="chatAction"] { min-height: 22px; padding: 2px 3px; border: none; background: transparent; color: #687286; font-size: 12px; font-weight: 500; }
QPushButton[uiClass="chatAction"]:hover, QPushButton[uiClass="chatAction"]:pressed { color: #4659bf; background: transparent; border: none; }
QLabel[uiClass="commentStars"] { color: #f2a900; font-size: 15px; background: transparent; }
QFrame#chatComposer { background: #ffffff; border: 1px solid #dfe2ea; border-radius: 18px; }
QFrame#chatComposer QPlainTextEdit { background: transparent; border: none; padding: 5px; }
QListWidget#userNavigation { background: #f1f3f9; border: none; border-radius: 14px; padding: 5px; }
QListWidget#userNavigation::item { padding: 0 13px; margin: 0; border: 1px solid transparent; border-radius: 10px; color: #626d82; }
QListWidget#userNavigation::item:hover { background: #e9edf7; }
QListWidget#userNavigation::item:selected { background: #ffffff; color: #37467f; border-color: #e6e9f3; font-weight: 600; }
QListWidget#userNavigation::item:focus { border-color: #93a0e1; }
QFrame#terminalSidebar { background: #ffffff; border: 1px solid #e9ecf4; border-radius: 22px; }
QListWidget#sidebarNavigation::item { margin: 4px 0; height: 43px; border-radius: 12px; padding: 0 9px; }
QListWidget#sidebarNavigation::item:selected { background: #edf0ff; color: #4659bf; border-color: transparent; }
QListWidget#sidebarNavigation::item:hover { background: #f4f5fa; }
QListWidget#sidebarNavigation::item:focus { border-color: #a3aedf; }
QLabel[uiClass="heroOverline"] { color: #c5cee8; font-size: 11px; }
QLabel[uiClass="discoveryTitle"] { color: #ffffff; font-size: 34px; font-weight: 700; }
QLabel[uiClass="discoveryCompactTitle"] { color: #ffffff; font-size: 26px; font-weight: 700; }
QWidget#discoveryHero QLabel[uiClass="heroCaption"], QWidget#loginVisual QLabel[uiClass="heroCaption"] { color: #c5cee8; font-size: 13px; }
QWidget#loginVisual QLabel[uiClass="heroTitle"] { color: #ffffff; font-size: 42px; }
QWidget#loginVisual QLabel[uiClass="brandName"] { color: #ffffff; }
QWidget#loginVisual QLabel[uiClass="eyebrow"] { color: #c5cee8; }
QFrame#discoverySearch { background: #ffffff; border: 1px solid #e9ecf4; border-radius: 18px; }
QFrame#discoverySearch QLineEdit, QFrame#discoverySearch QComboBox { background: #f5f7fb; border-color: #f0f2f8; border-radius: 11px; }
QFrame#discoverySearch QLineEdit:focus, QFrame#discoverySearch QComboBox:focus { border-color: #6475df; }
QLabel[uiClass="sectionTitle"] { font-size: 19px; font-weight: 600; }
QPushButton[uiClass="stationCard"] { background: #ffffff; border: 1px solid #e9ecf4; border-radius: 22px; }
QPushButton[uiClass="stationCard"]:hover { background: #fcfcff; border-color: #aab6ed; }
QPushButton[uiClass="stationCard"]:pressed { background: #f0f3ff; border-color: #7385df; }
QPushButton[uiClass="stationCard"]:focus { border: 2px solid #6475df; }
QLabel[uiClass="stationTitle"] { color: #252c3d; font-size: 18px; font-weight: 600; }
QLabel[uiClass="stationRating"] { color: #687286; font-size: 11px; }
QLabel[uiClass="stationHotReview"] { background: #fff0df; color: #c43f2c; border-radius: 8px; padding: 4px 7px; font-size: 11px; }
QLabel[uiClass="stationPrice"] { color: #2b3451; font-size: 25px; font-weight: 600; }
QPushButton[uiClass="stationCard"][available="false"] QLabel[uiClass="stationPrice"] { color: #2b3451; }
QLabel[uiClass="stationSymbol"] { background: #eff2fd; border-radius: 13px; }
QLabel[uiClass="distancePill"] { background: #f5f6fa; color: #626d82; border-radius: 9px; padding: 5px 9px; font-size: 12px; }
QLabel[uiClass="availabilityPill"] { background: #edf7f1; color: #2c7251; border-radius: 8px; padding: 4px 7px; font-size: 11px; }
QLabel[uiClass="unavailablePill"] { background: #f3f3f6; color: #687080; border-radius: 8px; padding: 4px 7px; font-size: 11px; }
QFrame[uiClass="statCard"][tone="blue"] { background: #253153; border-color: #253153; }
QFrame[uiClass="statCard"][tone="blue"] QLabel[uiClass="statValue"] { color: #ffffff; }
QFrame[uiClass="statCard"][tone="blue"] QLabel[uiClass="muted"] { color: #c8d0e6; }
QHeaderView::section { background: #f8f9fc; border-bottom: 1px solid #e9ecf4; color: #687286; padding: 12px 7px; }
