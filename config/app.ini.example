[network]
tcp_host=127.0.0.1
tcp_port=8888
http_host=127.0.0.1
http_port=8080
max_payload_bytes=10485760
reconnect_attempts=10

[database]
driver=QSQLITE
path=data/ev_charging.sqlite3
busy_timeout_ms=5000
wal_enabled=true

[runtime]
timezone=Asia/Shanghai
worker_threads=20
log_level=info

[external]
map_provider=tencent
map_api_key=
map_referer=EV-CHARGING-DEMO
model_endpoint=
model_api_key=
