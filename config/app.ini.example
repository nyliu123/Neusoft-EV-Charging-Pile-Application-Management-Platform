[network]
tcp_host=127.0.0.1
tcp_port=8888
http_host=127.0.0.1
http_port=8080
max_payload_bytes=10485760
reconnect_attempts=10

[database]
driver=QSQLITE
path=data/ev_charging.sqlite3
busy_timeout_ms=5000
wal_enabled=true

[runtime]
timezone=Asia/Shanghai
worker_threads=20
log_level=info

[ai]
provider=moonshot
model=kimi-k2.6
base_url=https://api.moonshot.cn/v1
api_key=

[external]
map_provider=openstreetmap
map_api_key=
model_endpoint=
model_api_key=
